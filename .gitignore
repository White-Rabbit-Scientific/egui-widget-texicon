# Generated by Cargo
/target/
debug/

# MSVC Windows debugging symbols (keep since you build on Windows)
*.pdb

# Recursive rustfmt backups
**/*.rs.bk

# Mutation testing output (keep if you use cargo-mutants)
**/mutants.out*/

# Zed editor project-specific settings
.zed/

# OS-specific metadata files across all three platforms
.DS_Store
Thumbs.db
Desktop.ini
*~
